{
  "title": "OBI eBPF — HTTP service instrumentation",
  "uid": "obi-ebpf-http",
  "tags": ["obi", "ebpf", "observability"],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "pluginId": "prometheus",
        "refresh": 1,
        "hide": 2,
        "current": {}
      },
      {
        "name": "job",
        "label": "App (exported_job)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_server_request_duration_seconds_count, exported_job)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "RED overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Request rate by app",
      "description": "Server-side requests/sec observed by eBPF, last 5m window.",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "colorMode": "value",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$job\"}[5m]))",
          "legendFormat": "{{exported_job}}",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate by app (5xx)",
      "description": "Percent of server-side responses with status 5xx. Apps with no 5xx series yet show as no-data, which is good news.",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "colorMode": "background",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$job\", http_response_status_code=~\"5..\"}[5m]))\n/\nsum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$job\"}[5m]))",
          "legendFormat": "{{exported_job}}",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency by app",
      "description": "Server-side request duration p95 over the last 5m window.",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "colorMode": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (exported_job, le) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$job\"}[5m])))",
          "legendFormat": "{{exported_job}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$job\"}[5m]))",
          "legendFormat": "{{exported_job}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server-side latency percentiles",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (exported_job, le) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$job\"}[5m])))",
          "legendFormat": "p50 {{exported_job}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (exported_job, le) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$job\"}[5m])))",
          "legendFormat": "p95 {{exported_job}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (exported_job, le) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$job\"}[5m])))",
          "legendFormat": "p99 {{exported_job}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP status codes",
      "description": "Stacked 5m rate by response status code.",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 75, "lineWidth": 0, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (exported_job, http_response_status_code) (rate(http_server_request_duration_seconds_count{exported_job=~\"$job\"}[5m]))",
          "legendFormat": "{{exported_job}} {{http_response_status_code}}",
          "range": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Top routes (req/s)",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" },
        "showHeader": true,
        "showViewControls": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(15, sum by (exported_job, http_route) (rate(http_server_request_duration_seconds_count{exported_job=~\"$job\"}[5m])))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "type": "row",
      "title": "Service topology (client → server)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 101,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Client → server call rate",
      "description": "Outgoing requests by dependency. OBI sees both ends, so this builds the dependency graph without app instrumentation.",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (exported_job, server_address, server_port) (rate(http_client_request_duration_seconds_count{exported_job=~\"$job\"}[5m]))",
          "legendFormat": "{{exported_job}} → {{server_address}}:{{server_port}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Client-side p95 per dependency",
      "description": "p95 of outgoing requests. A slow qbittorrent or external API backing up sonarr shows here.",
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (exported_job, server_address, le) (rate(http_client_request_duration_seconds_bucket{exported_job=~\"$job\"}[5m])))",
          "legendFormat": "{{exported_job}} → {{server_address}}",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "DNS health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 102,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "DNS lookups by error type",
      "description": "Currently 100% of observed DNS lookups in the cluster are NXDomain errors — check what these apps are resolving.",
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 75, "lineWidth": 0, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (exported_job, error_type) (rate(dns_lookup_duration_seconds_count{exported_job=~\"$job\"}[5m]))",
          "legendFormat": "{{exported_job}} {{error_type}}",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total NXDomain rate",
      "description": "Sum of failed DNS lookups per second across instrumented apps.",
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "colorMode": "background",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(dns_lookup_duration_seconds_count{error_type=\"NXDomain\"}[5m]))",
          "legendFormat": "NXDomain/s",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DNS lookup duration p95",
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (exported_job, le) (rate(dns_lookup_duration_seconds_bucket{exported_job=~\"$job\"}[5m])))",
          "legendFormat": "{{exported_job}}",
          "range": true
        }
      ]
    }
  ]
}